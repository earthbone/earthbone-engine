; Engine configuration file.
; Loads the soe-godot-host extension from ../target once Godot is installed.

config_version=5

[application]

config/name="Skyrim open engine host"
config/features=PackedStringArray("4.4")

[editor_plugins]

enabled=PackedStringArray("res://addons/soe_cell_editor/plugin.cfg", "res://addons/soe_forms/plugin.cfg")

[physics]

; Jolt ships inside Godot from 4.4, so the engine links no physics library of
; its own. See docs/physics.md for why the headless simulation keeps a separate
; world rather than running here.
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
